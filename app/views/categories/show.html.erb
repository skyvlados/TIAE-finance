<section class="column is-half">
  <h1 class="has-text-weight-bold is-size-5">Show form</h1>

    <div class="field mt-4">
        <label class="label">Name</label>
        <input class="input" type="text" placeholder="<%= @category.name %>" disabled>
    </div>

    <div class="field is-grouped">
        <p class="control">
          <%= back_to_list_button(
                categories_path(cookies[:categories_filters].then { JSON.parse(_1) if _1 } )
              ) %>
        </p>
    </div>
</section>
