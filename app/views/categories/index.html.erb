<div class="container px-4-mobile">
  <section class="section py-1">
    <h1 class="has-text-weight-bold is-size-5">
      Categories list
    </h1>

    <div class="field is-grouped mt-4">
      <p class="control">
        <%= link_to 'Create', new_category_path, class: "button is-link" %>
      </p>
    </div>

    <div class="field is-grouped">
      <%= form_with url: categories_path, method: "get"  do |form| %>
        <div class="field is-grouped">
          <div class="control">
            <label class="label">Name</label>
            <%= form.text_field :name,
                                type: "text",
                                class: "input",
                                :value => params[:name] %>
          </div>
        </div>


        <div class="field is-grouped">
          <div class="control">
            <div class="select">
              <% page_size=%i[5 10 25 50]%>
              <%= form.select :page_size, page_size.each { |key| [key, key] },
                              selected: params[:page_size],
                              prompt: 'Select page size'%>
            </div>
            <%= form.submit "Filter", class: "button is-link" %>
          </div>
        </div>
      <% end %>
    </div>

    <table class="table">
      <tr>
        <th>id</th>
        <th>name</th>
        <th>actions</th>
      </tr>
      <% @categories.each do |category|  %>
            <tr>
              <td><%= category.id %></td>
              <td><%= category.name %></td>
              <td>
                <%= link_to 'Show', category %>
                <%= link_to 'Edit', [:edit, category] %>
                <%= link_to "Destroy", category, data: {
                                    turbo_method: :delete,
                                    turbo_confirm: "Are you sure?"
                                  } %>
              </td>
            </tr>
      <% end %>
    </table>

    <div class="mt-4">
      <div class="is-inline-flex">
        <%== render partial: 'shared/pagination', locals: {pagy: @pagy} %>
      </div>

      <div class="mt-4">
        <%= link_to 'Back to Home page', root_path, class: "button is-light" %>
      </div>
    </div>
  </section>
</div>
