<%= form_with model: @category do |form| %>
  <div class="field">
    <label class="label">Name</label>
        <%= form.text_field :name, class: "input", placeholder: "category name" %>
    <% @category.errors.full_messages_for(:name).each do |message| %>
      <p class="help is-danger">
        <%= message %>
      </p>
    <% end %>
  </div>

  <div class="field is-grouped is-grouped-multiline">
    <p class="control">
      <%= form.submit button_text, class: "button is-link is-fullwidth" %>
    </p>
    <p class="control is-fullwidth-mobile">
      <%= back_to_list_button(
            categories_path(cookies[:categories_filters].then { JSON.parse(_1) if _1 } )
          ) %>
    </p>
  </div>
<% end %>
