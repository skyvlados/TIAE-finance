<section class="column is-half">
  <h1 class="has-text-weight-bold is-size-5">Show form</h1>

  <div class="field mt-4">
      <label class="label">Name</label>
      <input class="input" type="text" placeholder=<%= @user.name %> disabled>
  </div>

  <div class="field">
      <label class="label">Telegram Id</label>
      <input class="input" type="text" placeholder=<%= @user.telegram_id %> disabled>
  </div>

  <div class="field is-grouped">
      <p class="control">
        <%= link_to 'Back to list'.html_safe, users_path, class: "button is-light" %>
      </p>
  </div>
</section>
