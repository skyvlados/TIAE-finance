<div class="container px-4-mobile">
  <section class="section py-1">
      <h1 class="has-text-weight-bold is-size-5">Users list</h1>

      <div class="is-hidden-tablet mt-4">
        <div class="is-flex is-align-items-center mb-3">

          <details class="mobile-filters mr-3">
            <summary class="button is-light">
              🔍 Filters
            </summary>

            <div class="box filters-dropdown">
              <%= form_with url: users_path, method: "get"  do |form| %>
                <div class="field">
                  <label class="label">Name</label>
                  <div class="control">
                    <%= form.text_field :name, value: params.dig(:name),
                                        class: "input",
                                        placeholder: "Name" %>
                  </div>
                </div>

                <div class="field">
                  <label class="label">Telegram Id</label>
                  <div class="control">
                    <%= form.text_field :telegram_id, value: params.dig(:telegram_id),
                                        class: "input",
                                        placeholder: "Telegram Id" %>
                  </div>
                </div>

                <div class="field">
                  <div class="control">
                    <div class="select is-fullwidth">
                      <% page_size=%i[5 10 25 50]%>
                      <%= form.select :page_size, page_size.each { |key| [key, key] },
                                      selected: params[:page_size],
                                      prompt: 'Select page size'%>
                    </div>
                  </div>
                </div>

                <div class="field">
                  <div class="control">
                    <%= form.submit "Filter", class: "button is-link is-fullwidth" %>
                  </div>
                </div>
              <% end %>
            </div>
          </details>
        </div>
      </div>

      <div class="is-hidden-mobile mt-4">
        <%= form_with url: users_path, method: "get"  do |form| %>
          <div class="control">
            <div class="field is-grouped">
              <div class="control">
                <label class="label">Name</label>
                <%= form.text_field :name, value: params.dig(:name),
                                    class: "input",
                                    placeholder: "Name" %>
              </div>

              <div class="control">
              <label class="label">Telegram Id</label>
                <%= form.text_field :telegram_id, value: params.dig(:telegram_id),
                                    class: "input",
                                    placeholder: "Telegram Id" %>
              </div>
            </div>

            <div class="field is-grouped">
              <div class="control">
                <div class="select">
                  <% page_size= [5, 10, 25, 50] %>
                  <%= form.select :page_size,
                                  page_size.map { |key| [key, key] },
                                  selected: params[:page_size],
                                  prompt: 'Select page size'%>
                </div>
              </div>

              <div class="control">
                <%= form.submit "Filter", class: "button is-link" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <table class="table">
            <tr>
              <th>id</th>
              <th>name</th>
              <th>telegram id</th>
              <th>actions</th>
            </tr>

            <% @users.each do |user|  %>
                  <tr>
                    <td><%= user.id %></td>
                    <td><%= user.name %></td>
                    <td><%= user.telegram_id %></td>
                    <td>
                        <%= link_to 'Show', user %>
                        <%= link_to 'Edit', [:edit, user] %>
                        <%= link_to "Destroy", user, data: {
                                          turbo_method: :delete,
                                          turbo_confirm: "Are you sure?"
                                        } %>
                    </td>
                  </tr>
            <% end %>
      </table>

      <div class="mt-4">
        <div class="is-inline-flex">
          <%== render partial: 'shared/pagination', locals: {pagy: @pagy} %>
        </div>

        <div class="mt-4">
          <%= link_to 'Back to Home page', root_path, class: "button is-light" %>
        </div>
      </div>
  </section>
</div>
