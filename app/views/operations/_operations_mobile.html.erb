<div class="operation-row py-2">
  <div class="is-flex is-justify-content-space-between is-align-items-center">
    <div>
      <div class="is-size-7 has-text-weight-semibold">
        <%= operation.category.name %>
      </div>
      <div class="is-size-7 has-text-grey">
        <%= operation.date.strftime("%d.%m.%Y %H:%M") %>
      </div>
    </div>

    <div class="has-text-right">
      <div class="is-flex is-align-items-center is-justify-content-flex-end">
        <span class="is-size-6 has-text-weight-bold mr-2
          <%= operation.direction == 'income' ? 'has-text-success' : 'has-text-danger' %>">
          <%= operation.amount %> <%= operation.currency %>
        </span>
        <%= link_to '✏️',
                    [:edit, operation],
                    class: "button is-small is-white p-1 mr-1" %>
        <%= link_to '🗑',
                    operation,
                    class: "button is-small is-white p-1",
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: "Are you sure?"
                    } %>
      </div>

      <div class="is-size-7 mt-1">
        <span class="tag is-small <%= operation.direction == 'income' ? 'is-success' : 'is-danger' %> is-light">
          <%= operation.direction %>
        </span>
      </div>
    </div>
  </div>

  <% if operation.comment.present? %>
    <div class="is-size-7 has-text-grey mt-1">
      <%= operation.comment %>
    </div>
  <% end %>
</div>
