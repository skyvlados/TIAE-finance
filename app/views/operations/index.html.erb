<div class="container px-4-mobile">
  <section class="section py-1">
      <h1 class="has-text-weight-bold is-size-5">Operations list</h1>

      <div class="is-hidden-tablet mt-4">
        <div class="is-flex is-align-items-center mb-3">

          <details class="mobile-filters mr-3">
            <summary class="button is-light">
              🔍 Filters
            </summary>

            <div class="box filters-dropdown">
              <%= render 'filters_mobile' %>
            </div>
          </details>

          <%= link_to 'Create', new_operation_path, class: "button is-success" %>
        </div>
      </div>

      <div class="is-hidden-tablet mt-4">
        <%= render partial: 'operations_mobile', collection: @operations, as: :operation %>
        <%== render partial: 'shared/pagination', locals: {pagy: @pagy} %>
      </div>

      <div class="is-hidden-tablet mt-4">
        <div class="field is-grouped is-grouped-multiline">
          <div class="is-flex is-align-items-center mb-3">
            <%= link_to 'Download as Excel',
                        operations_path(**@params, format: :xlsx),
                        class: "button is-success" %>
            <div class="is-hidden-tablet ml-3">
              <%= link_to 'Import from excel'.html_safe, new_import_path, class: "button is-link" %>
            </div>
          </div>

          <div class="is-flex is-align-items-center mb-3">
            <details class="mobile-filters mr-3">
              <summary class="button is-light">
                Totals
              </summary>

              <div class="box filters-dropdown">
                <% @totals_operations.each do |operation| %>
                  <% amount, currency, direction = operation %>

                  <div class="tags has-addons is-justify-content-space-between mb-2">
                    <span class="tag <%= direction == 'income' ? 'is-success' : 'is-danger' %>">
                      <%= direction %>
                    </span>

                    <span class="tag is-light">
                      <%= amount %> <%= currency %>
                    </span>
                  </div>

                <% end %>
              </div>
            </details>

            <%= link_to 'Back to home page'.html_safe, root_path, class: "button is-light" %>
          </div>
        </div>
      </div>

      <div class="is-hidden-mobile mt-4">
          <%= form_with url: operations_path, method: "get"  do |form| %>
            <div class="control">
              <div class="field">
                <div class="select">
                  <%= form.select :currency, Operation.currencies.keys.map { |key| [key, key] },
                                  selected: params[:currency],
                                  include_blank: "All currencies" %>
                </div>
                <div class="select">
                  <%= form.select :direction, Operation.directions.keys.map { |key| [key, key] },
                                  selected: params[:direction],
                                  include_blank: "All directions" %>
                </div>
                <div class="select">
                  <%= form.select :category, Category.all.map { |object| [object.name, object.id] },
                                  selected: params[:category],
                                  include_blank: "All categories" %>
                </div>
              </div>

              <div class="field is-grouped">
                <div class="control">
                  <label class="label">Start date</label>
                  <%= form.date_field :date_start,
                                      type: "date",
                                      class: "input",
                                      :value => params[:date_start] %>
                </div>
                <div class="control">
                  <label class="label">Finish date</label>
                  <%= form.date_field :date_finish,
                                      type: "date",
                                      class: "input",
                                      :value => params[:date_finish] %>
                </div>
                <div class="control">
                  <label class="label">Comment</label>
                  <%= form.text_field :comment,
                                      type: "text",
                                      class: "input",
                                      :value => params[:comment] %>
                </div>
                <div class="control">
                  <label class="label">Order by date</label>
                  <div class="select">
                    <%= form.select :order_by_date,
                                    OperationQuery::TRANSLATE_ORDER_PARAMS.to_a,
                                    selected: params[:order_by_date] %>
                  </div>
                </div>
              </div>

              <div class="field is-grouped">
                <div class="control">
                  <div class="select">
                    <% page_size= [5, 10, 25, 50] %>
                    <%= form.select :page_size,
                                    page_size.map { |key| [key, key] },
                                    selected: params[:page_size],
                                    prompt: 'Select page size'%>
                  </div>
                </div>

                <div class="control">
                  <%= form.submit "Filter", class: "button is-link" %>
                </div>

                <div class="control">
                  <%= link_to 'Create', new_operation_path, class: "button is-success" %>
                </div>

                <div class="control">
                  <button type="submit"
                          form="mass_delete_form"
                          class="button is-danger">
                    Mass delete
                  </button>
                </div>
              </div>
            </div>
          <% end %>

          <div class="mt-4">
            <%= form_with url: operations_mass_delete_path,
                          method: "delete",
                          id: "mass_delete_form",
                          data: { turbo_confirm: "Are you sure?" }  do %>
              <table class="table">
                <tr>
                  <th></th>
                  <th>id</th>
                  <th>category</th>
                  <th>direction</th>
                  <th>amount</th>
                  <th>currency</th>
                  <th>data</th>
                  <th>comment</th>
                  <th>actions</th>
                </tr>
                <% @operations.each do |operation| %>
                  <tr>
                    <td>
                      <label>
                        <%= check_box_tag "cleaner[operations_ids][]", operation.id%>
                      </label>
                    </td>
                    <td><%= operation.id %></td>
                    <td><%= operation.category.name %></td>
                    <td><%= operation.direction %></td>
                    <td><%= operation.amount %></td>
                    <td><%= operation.currency %></td>
                    <td><%= operation.date.strftime("%d-%m-%Y %H:%M:%S") %></td>
                    <td><%= operation.comment %></td>
                    <td>
                      <%= link_to 'Show', operation %>
                      <%= link_to 'Edit', [:edit, operation] %>
                      <%= link_to "Destroy", operation, data: {
                        turbo_method: :delete,
                        turbo_confirm: "Are you sure?"
                      } %>
                    </td>
                  </tr>
                <% end %>
              </table>

              <div class="mt-4">
                <div class="is-inline-flex">
                  <%== render partial: 'shared/pagination', locals: {pagy: @pagy} %>
                </div>
              </div>

              <div class="is-hidden-mobile mt-4 is-flex is-align-items-center">
                <details class="tablet-totals">
                  <summary class="button is-light">
                    Totals
                  </summary>

                  <table class="table is-fullwidth" data-totals-target="table">
                    <tr>
                      <th>Amount</th>
                      <th>Currency</th>
                      <th>Direction</th>
                    </tr>

                    <% @totals_operations.each do |operation| %>
                      <tr>
                        <% operation.each do |value| %>
                          <td><%= value %></td>
                        <% end %>
                      </tr>
                    <% end %>
                  </table>
                </details>

                <div class="ml-3">
                  <%= link_to 'Download as Excel',
                              operations_path(**@params, format: :xlsx),
                              class: "button is-success" %>
                </div>
                <div class="ml-3">
                  <%= link_to 'Import from excel'.html_safe, new_import_path, class: "button is-link" %>
                </div>
                <div class="ml-3">
                  <%= link_to 'Back to home page'.html_safe, root_path, class: "button is-light" %>
                </div>
              </div>
            <% end %>
          </div>
      </div>
  </section>
</div>
